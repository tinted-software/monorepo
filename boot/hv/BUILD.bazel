load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load(":qemu.bzl", "qemu_hv_runner")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "qemu_system_target_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

# Superbird (Meson G12A) build targets (default, feature = not(qemu))
rust_library(
    name = "darwin-hv-lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "darwin_hv",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "@crates//:aarch64-cpu",
        "@crates//:spin",
    ],
)

rust_binary(
    name = "darwin-hv_raw",
    srcs = ["src/main.rs"],
    compile_data = ["boot/linker.ld"],
    edition = "2024",
    rustc_flags = [
        "-C",
        "link-arg=-Tboot/hv/boot/linker.ld",
        "-C",
        "force-frame-pointers=yes",
    ],
    tags = ["manual"],
    deps = [
        ":darwin-hv-lib",
        "@crates//:aarch64-cpu",
        "@crates//:spin",
    ],
)

platform_transition_binary(
    name = "darwin-hv",
    binary = ":darwin-hv_raw",
    target_platform = "@rules_rs//rs/platforms:aarch64-unknown-none",
)

# QEMU virt machine build targets (crate_features = ["qemu"])
rust_library(
    name = "darwin-hv-qemu-lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_features = ["qemu"],
    crate_name = "darwin_hv",
    edition = "2024",
    tags = ["manual"],
    deps = [
        "@crates//:aarch64-cpu",
        "@crates//:spin",
    ],
)

rust_binary(
    name = "darwin-hv-qemu_raw",
    srcs = ["src/main.rs"],
    compile_data = ["boot/linker-qemu.ld"],
    crate_features = ["qemu"],
    edition = "2024",
    rustc_flags = [
        "-C",
        "link-arg=-Tboot/hv/boot/linker-qemu.ld",
        "-C",
        "force-frame-pointers=yes",
    ],
    tags = ["manual"],
    deps = [
        ":darwin-hv-qemu-lib",
        "@crates//:aarch64-cpu",
        "@crates//:spin",
    ],
)

platform_transition_binary(
    name = "darwin-hv-qemu",
    binary = ":darwin-hv-qemu_raw",
    target_platform = "@rules_rs//rs/platforms:aarch64-unknown-none",
)

qemu_hv_runner(
    name = "run_qemu",
    hv = ":darwin-hv-qemu_raw",
)
