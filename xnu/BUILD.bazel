# --- Kernel binary target ---

cc_binary(
    name = "mach_kernel_raw",
    linkopts = [
        "-nostdlib",
        "-Wl,-static",
        "-Wl,-e,_start",
        "-Wl,-pagezero_size,0",
        "-Wl,-image_base,0xfffffe0007004000",
    ],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    deps = [
        ":xnu_arm64_vmapple_lib",
    ],
)

# --- Transitioned aliases (no --platforms required on CLI) ---

platform_transition_filegroup(
