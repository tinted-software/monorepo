    name = "xnu_arm64_vmapple_lib",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    deps = [
        ":bsd_arm64_vmapple_asm",
        ":bsd_arm64_vmapple_lib",
        ":iokit_arm64_vmapple_asm",
        ":iokit_arm64_vmapple_lib",
        ":libkern_arm64_vmapple_asm",
        ":libkern_arm64_vmapple_lib",
        ":libsa_arm64_vmapple_asm",
        ":libsa_arm64_vmapple_lib",
        ":osfmk_arm64_vmapple_asm",
        ":osfmk_arm64_vmapple_lib",
