    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
    deps = [
        ":mig_hdrs",
        "@xnu//:kernel_headers",
    ],
    alwayslink = True,
