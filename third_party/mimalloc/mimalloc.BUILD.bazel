load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

_MIMALLOC_COPTS = [
    "-std=c11",
    "-DMI_MALLOC_OVERRIDE",
] + select({
    "@platforms//os:windows": [],
    "//conditions:default": [
        "-pthread",
    ],
})

_MIMALLOC_LINKOPTS = select({
    "@platforms//os:windows": [
        "-DEFAULTLIB:advapi32.lib",
        "-DEFAULTLIB:bcrypt.lib",
        "-DEFAULTLIB:user32.lib",
    ],
    "@platforms//os:macos": [
        "-pthread",
    ],
    "//conditions:default": [
        "-pthread",
        "-lrt",
    ],
})

cc_library(
    name = "mimalloc",
    srcs = ["src/static.c"],
    hdrs = glob(
        ["include/**/*.h"],
        allow_empty = True,
    ),
    copts = _MIMALLOC_COPTS,
    includes = [
        "include",
        "src",
        "src/prim",
    ],
    linkopts = _MIMALLOC_LINKOPTS,
    textual_hdrs = glob(
        [
            "src/**/*.h",
            "src/**/*.c",
        ],
        allow_empty = True,
    ),
    alwayslink = True,
)

alias(
    name = "mimalloc_override",
    actual = ":mimalloc",
)
